  "segments": [
    {
      "segmentId": "03-bencao-ep12-s001",
      "chapter": "半夏",
      "contentType": "shennong-bencao",
      "completeness": "partial",
      "tStartMs": 7000,
      "tEndMs": null,
      "internalGapsMs": [
        21000,
        21000,
        35000,
        56000
      ],
      "cues": [
        {
          "id": "03-bencao-ep12#1",
          "tStartMs": 7000,
          "text": "这市面上呢一大堆名称，法半夏，"
        },
        {
          "id": "03-bencao-ep12#2",
          "tStartMs": 28000,
          "text": "平常呢你诊所里面放一些生半夏"
        },
        {
          "id": "03-bencao-ep12#3",
          "tStartMs": 49000,
          "text": "把那个生半夏放在袋子里面啊，一边跟他讲话"
        },
        {
          "id": "03-bencao-ep12#4",
          "tStartMs": 84000,
          "text": "我们使用生半夏是在涤痰去痰的时候使用最多"
        },
        {
          "id": "03-bencao-ep12#5",
          "tStartMs": 140000,
          "text": "那喉咙里面的痰整个都吐出来，人就醒过来急救"
        }
      ]
    },
    {
      "segmentId": "03-bencao-ep12-s002",
      "chapter": "半夏",
      "contentType": "shennong-bencao",
      "completeness": "partial",
      "tStartMs": 160000,
      "tEndMs": null,
      "internalGapsMs": [
        39000,
        40000,
        26000,
        23000
      ],
      "cues": [
        {
          "id": "03-bencao-ep12#6",
          "tStartMs": 160000,
          "text": "所以生用处有的时候它会有毒"
        },
        {
          "id": "03-bencao-ep12#7",
          "tStartMs": 199000,
          "text": "所以我们叫它婆婆药，你要她声音恢复很简单"
        },
        {
          "id": "03-bencao-ep12#8",
          "tStartMs": 239000,
          "text": "我们过去有婆婆药就是讲这个生半夏"
        },
        {
          "id": "03-bencao-ep12#9",
          "tStartMs": 265000,
          "text": "半夏开出来通通是生半夏、生姜两片就结東啦"
        },
        {
          "id": "03-bencao-ep12#10",
          "tStartMs": 288000,
          "text": "至于法半夏那是他们自己炮制的方法嘛中国人最喜欢称流派，"
        }
      ]
    },
    {
      "segmentId": "03-bencao-ep12-s003",
      "chapter": "半夏",
      "contentType": "shennong-bencao",
      "completeness": "partial",
      "tStartMs": 329000,
      "tEndMs": null,
      "internalGapsMs": [
        34000,
        23000,
        22000
      ],
      "cues": [
        {
          "id": "03-bencao-ep12#11",
          "tStartMs": 329000,
          "text": "我们要靠生半夏把它清掉，"
        },
        {
          "id": "03-bencao-ep12#12",
          "tStartMs": 363000,
          "text": "你通通过去了水还排不出来，那这个人差不多了"
        },
        {
          "id": "03-bencao-ep12#13",
          "tStartMs": 386000,
          "text": "一开始讲的水就是讲的这个痰就是这个半夏，"
        },
        {
          "id": "03-bencao-ep12#14",
          "tStartMs": 408000,
          "text": "有的人需要的水但是很少的量"
        }
      ]
    },
    {
      "segmentId": "03-bencao-ep12-s004",
      "chapter": "半夏",
      "contentType": "shennong-bencao",
      "completeness": "partial",
      "tStartMs": 485000,
      "tEndMs": null,
      "internalGapsMs": [
        33000,
        24000,
        26000,
        28000,
        31000
      ],
      "cues": [
        {
          "id": "03-bencao-ep12#15",
          "tStartMs": 485000,
          "text": "最高的水要靠半夏来去"
        },
        {
          "id": "03-bencao-ep12#16",
          "tStartMs": 518000,
          "text": "主治你看半夏是除湿化痰的药止呕止哕打嗝逆喉咙呕"
        },
        {
          "id": "03-bencao-ep12#17",
          "tStartMs": 542000,
          "text": "你看他用半夏，后面用干姜，"
        },
        {
          "id": "03-bencao-ep12#18",
          "tStartMs": 568000,
          "text": "因为它止恶心的力量很强止呕去水"
        },
        {
          "id": "03-bencao-ep12#19",
          "tStartMs": 596000,
          "text": "我们一般不用半夏，因为半夏抵水力量很强，越吃越渴"
        },
        {
          "id": "03-bencao-ep12#20",
          "tStartMs": 627000,
          "text": "来看看这个，里面白色的一颗一颗的应该就是生半夏"
        }
      ]
    },
    {
      "segmentId": "03-bencao-ep12-s005",
      "chapter": "半夏",
      "contentType": "shennong-bencao",
      "completeness": "partial",
      "tStartMs": 655000,
      "tEndMs": null,
      "internalGapsMs": [
        34000,
        36000,
        43000
      ],
      "cues": [
        {
          "id": "03-bencao-ep12#21",
          "tStartMs": 655000,
          "text": "吴菜萸是寒症的，肝脏方面来的，半夏是水饮造成的恶心"
        },
        {
          "id": "03-bencao-ep12#22",
          "tStartMs": 689000,
          "text": "所以我们常常用半夏来那胃，健脾。"
        },
        {
          "id": "03-bencao-ep12#23",
          "tStartMs": 725000,
          "text": "就不是靠半夏，是靠干姜"
        },
        {
          "id": "03-bencao-ep12#24",
          "tStartMs": 768000,
          "text": "因沩半夏正好在夏天正中间的时候！"
        }
      ]
    },
    {
      "segmentId": "03-bencao-ep12-s006",
      "chapter": "半夏",
      "contentType": "shennong-bencao",
      "completeness": "partial",
      "tStartMs": 822000,
      "tEndMs": null,
      "internalGapsMs": [
        43000,
        35000,
        20000,
        24000
      ],
      "cues": [
        {
          "id": "03-bencao-ep12#25",
          "tStartMs": 822000,
          "text": "因为我们前面用生半夏把喉咙声音都去掉了那很厉害"
        },
        {
          "id": "03-bencao-ep12#26",
          "tStartMs": 865000,
          "text": "巴豆下去开那是很凶的药"
        },
        {
          "id": "03-bencao-ep12#27",
          "tStartMs": 900000,
          "text": "他这个症状就是标准的身体里有淤血就是这种感觉，"
        },
        {
          "id": "03-bencao-ep12#28",
          "tStartMs": 920000,
          "text": "淤血症就是口渴不欲饮，在经方里面讲的很清楚血症不用"
        },
        {
          "id": "03-bencao-ep12#29",
          "tStartMs": 944000,
          "text": "所以不要随便用半夏，止恶心呕吐，就像我"
        },
        {
          "id": "03-bencao-ep12#30",
          "tStartMs": 984000,
          "text": "所以孕姮使用的时候我们用干姜"
        }
      ]
    },
    {
      "segmentId": "03-bencao-ep12-s007",
      "chapter": "虎掌",
      "contentType": "shennong-bencao",
      "completeness": "partial",
      "tStartMs": 1014000,
      "tEndMs": null,
      "internalGapsMs": [
        55000,
        39000,
        31000,
        20000
      ],
      "cues": [
        {
          "id": "03-bencao-ep12#31",
          "tStartMs": 1014000,
          "text": "你如果那个虎掌，老经验的人就会知道"
        },
        {
          "id": "03-bencao-ep12#32",
          "tStartMs": 1069000,
          "text": "它政痰的力量非常的强，"
        },
        {
          "id": "03-bencao-ep12#33",
          "tStartMs": 1108000,
          "text": "不单和半夏。不单单是在这个地方，"
        },
        {
          "id": "03-bencao-ep12#34",
          "tStartMs": 1139000,
          "text": "还小孩子呢这个咳嗽他都有痰"
        },
        {
          "id": "03-bencao-ep12#35",
          "tStartMs": 1159000,
          "text": "羊水啊留在肺里面很多，痰水"
        }
      ]
    },
    {
      "segmentId": "03-bencao-ep12-s008",
      "chapter": "虎掌",
      "contentType": "shennong-bencao",
      "completeness": "partial",
      "tStartMs": 1179000,
      "tEndMs": null,
      "internalGapsMs": [
        21000,
        22000,
        32000,
        23000,
        27000
      ],
      "cues": [
        {
          "id": "03-bencao-ep12#36",
          "tStartMs": 1179000,
          "text": "像天南星就是单味的药"
        },
        {
          "id": "03-bencao-ep12#37",
          "tStartMs": 1200000,
          "text": "所以中风的人没有办法讲话：口噤，喉咙痰很多"
        },
        {
          "id": "03-bencao-ep12#38",
          "tStartMs": 1222000,
          "text": "那老师半夏去痰，天南星也去痰，两个差异在哪里"
        },
        {
          "id": "03-bencao-ep12#39",
          "tStartMs": 1254000,
          "text": "我们大部分都会去痰，痰饮会造成很多的怪病"
        },
        {
          "id": "03-bencao-ep12#40",
          "tStartMs": 1277000,
          "text": "所以痰饮是主症，其它有很多附带的症状被看到，"
        },
        {
          "id": "03-bencao-ep12#41",
          "tStartMs": 1304000,
          "text": "所以你们大致的药的功能要了解"
        }
      ]
    },
    {
      "segmentId": "03-bencao-ep12-s009",
      "chapter": "虎掌",
      "contentType": "shennong-bencao",
      "completeness": "partial",
      "tStartMs": 1341000,
      "tEndMs": null,
      "internalGapsMs": [
        52000,
        40000,
        30000
      ],
      "cues": [
        {
          "id": "03-bencao-ep12#42",
          "tStartMs": 1341000,
          "text": "小孩子受了惊吓啊常常发烧啊怎么样，就是痰饮"
        },
        {
          "id": "03-bencao-ep12#43",
          "tStartMs": 1393000,
          "text": "所以沩什么天南星可以治疗皮肤病"
        },
        {
          "id": "03-bencao-ep12#44",
          "tStartMs": 1433000,
          "text": "能补肝风虚，治痰功同半夏治疗痰的功能跟半夏一样"
        },
        {
          "id": "03-bencao-ep12#45",
          "tStartMs": 1463000,
          "text": "就代表里面有毒哦，得防风则不麻"
        }
      ]
    },
    {
      "segmentId": "03-bencao-ep12-s010",
      "chapter": "大黄",
      "contentType": "shennong-bencao",
      "completeness": "partial",
      "tStartMs": 1511000,
      "tEndMs": null,
      "internalGapsMs": [
        20000,
        21000,
        41000,
        49000
      ],
      "cues": [
        {
          "id": "03-bencao-ep12#46",
          "tStartMs": 1511000,
          "text": "大黄昵又有个名称"
        },
        {
          "id": "03-bencao-ep12#47",
          "tStartMs": 1531000,
          "text": "它性如将军，非常的彪悍，叉明州军，甘肃省也产大黄"
        },
        {
          "id": "03-bencao-ep12#48",
          "tStartMs": 1552000,
          "text": "好生半夏啊，什么天南星，大黄，芒硝，"
        },
        {
          "id": "03-bencao-ep12#49",
          "tStartMs": 1593000,
          "text": "为什么他们南派的不敢用大黄"
        },
        {
          "id": "03-bencao-ep12#50",
          "tStartMs": 1642000,
          "text": "但大黄本身不去赛也不去热"
        }
      ]
    },
    {
      "segmentId": "03-bencao-ep12-s011",
      "chapter": "大黄",
      "contentType": "shennong-bencao",
      "completeness": "partial",
      "tStartMs": 1667000,
      "tEndMs": null,
      "internalGapsMs": [
        20000,
        26000,
        39000,
        22000,
        40000
      ],
      "cues": [
        {
          "id": "03-bencao-ep12#51",
          "tStartMs": 1667000,
          "text": "我们要阴阳表里虚实寒热"
        },
        {
          "id": "03-bencao-ep12#52",
          "tStartMs": 1687000,
          "text": "可是便秘还再回来，那你不能靠吃大黄过目子啊，"
        },
        {
          "id": "03-bencao-ep12#53",
          "tStartMs": 1713000,
          "text": "单是实，单单是实症，那就是大黄，"
        },
        {
          "id": "03-bencao-ep12#54",
          "tStartMs": 1752000,
          "text": "停在胃里面，这个时候要靠大黄"
        },
        {
          "id": "03-bencao-ep12#55",
          "tStartMs": 1774000,
          "text": "所以说你下去就跑掉啦"
        },
        {
          "id": "03-bencao-ep12#56",
          "tStartMs": 1814000,
          "text": "按照瘦量，是百分之二十也就是说"
        }
      ]
    },
    {
      "segmentId": "03-bencao-ep12-s012",
      "chapter": "大黄",
      "contentType": "shennong-bencao",
      "completeness": "partial",
      "tStartMs": 1837000,
      "tEndMs": null,
      "internalGapsMs": [
        20000,
        31000,
        32000,
        22000,
        36000
      ],
      "cues": [
        {
          "id": "03-bencao-ep12#57",
          "tStartMs": 1837000,
          "text": "所以我们人可以容许一个礼拜不吃食物；"
        },
        {
          "id": "03-bencao-ep12#58",
          "tStartMs": 1857000,
          "text": "慢点，所以中药是缓嘛"
        },
        {
          "id": "03-bencao-ep12#59",
          "tStartMs": 1888000,
          "text": "当你没有你如果说大黄下去跟甘草下去的时候，"
        },
        {
          "id": "03-bencao-ep12#60",
          "tStartMs": 1920000,
          "text": "【性味】呢，味大普，性大寒，无毒味蓍哤"
        },
        {
          "id": "03-bencao-ep12#61",
          "tStartMs": 1942000,
          "text": "这个大黄很好用【主治】"
        },
        {
          "id": "03-bencao-ep12#62",
          "tStartMs": 1978000,
          "text": "所以，很多女人呢几乎都要用到失黄。"
        }
      ]
    },
    {
      "segmentId": "03-bencao-ep12-s013",
      "chapter": "大黄",
      "contentType": "shennong-bencao",
      "completeness": "partial",
      "tStartMs": 2005000,
      "tEndMs": null,
      "internalGapsMs": [
        24000,
        64000,
        46000
      ],
      "cues": [
        {
          "id": "03-bencao-ep12#63",
          "tStartMs": 2005000,
          "text": "泻心下痞。张仲景用大黄的地方很多"
        },
        {
          "id": "03-bencao-ep12#64",
          "tStartMs": 2029000,
          "text": "你看像牛肉干锦续大黄嘛？锦纹，纹路很好看"
        },
        {
          "id": "03-bencao-ep12#65",
          "tStartMs": 2093000,
          "text": "我们一一当你药性很了解的时候，"
        },
        {
          "id": "03-bencao-ep12#66",
          "tStartMs": 2139000,
          "text": "这时我们知道处方，大黄是对症的"
        }
      ]
    },
    {
      "segmentId": "03-bencao-ep12-s014",
      "chapter": "大黄",
      "contentType": "shennong-bencao",
      "completeness": "partial",
      "tStartMs": 2197000,
      "tEndMs": null,
      "internalGapsMs": [
        26000,
        66000,
        26000,
        30000,
        25000
      ],
      "cues": [
        {
          "id": "03-bencao-ep12#67",
          "tStartMs": 2197000,
          "text": "所以昵这个【唐容川】。大黄气味都很厚"
        },
        {
          "id": "03-bencao-ep12#68",
          "tStartMs": 2223000,
          "text": "所以，我们天黄呢是治火的药它是攻"
        },
        {
          "id": "03-bencao-ep12#69",
          "tStartMs": 2289000,
          "text": "怎么办呢？寒极，不行"
        },
        {
          "id": "03-bencao-ep12#70",
          "tStartMs": 2315000,
          "text": "所以一一你们放心"
        },
        {
          "id": "03-bencao-ep12#71",
          "tStartMs": 2345000,
          "text": "哎，他吃生附于子谅下去了！所以，"
        },
        {
          "id": "03-bencao-ep12#72",
          "tStartMs": 2369000,
          "text": "所以说亡能够治胸满腹满丶便秘啊"
        },
        {
          "id": "03-bencao-ep12#73",
          "tStartMs": 2394000,
          "text": "能够往上焦走，质清味淡，能上清头目"
        }
      ]
    },
    {
      "segmentId": "03-bencao-ep12-s015",
      "chapter": "葶苈子",
      "contentType": "shennong-bencao",
      "completeness": "partial",
      "tStartMs": 2453000,
      "tEndMs": null,
      "internalGapsMs": [
        28000,
        58000,
        24000
      ],
      "cues": [
        {
          "id": "03-bencao-ep12#74",
          "tStartMs": 2453000,
          "text": "葶苈子我们遇到在经方里面使用的药，很多的时候"
        },
        {
          "id": "03-bencao-ep12#75",
          "tStartMs": 2481000,
          "text": "一般来说我们治疗肺癌的时候会用到葶苈子"
        },
        {
          "id": "03-bencao-ep12#76",
          "tStartMs": 2539000,
          "text": "因为肺是肾脏的妈妈，所以肺是肾水的上源，上源嘛"
        },
        {
          "id": "03-bencao-ep12#77",
          "tStartMs": 2563000,
          "text": "所以说它能够治喘、喘气，非常好用"
        }
      ]
    },
    {
      "segmentId": "03-bencao-ep12-s016",
      "chapter": "葶苈子",
      "contentType": "shennong-bencao",
      "completeness": "partial",
      "tStartMs": 2607000,
      "tEndMs": null,
      "internalGapsMs": [
        30000,
        45000,
        32000,
        22000
      ],
      "cues": [
        {
          "id": "03-bencao-ep12#78",
          "tStartMs": 2607000,
          "text": "所以很多药可以治疗肺"
        },
        {
          "id": "03-bencao-ep12#79",
          "tStartMs": 2637000,
          "text": "隐含在一介于巴豆与大黄二者之间的药也是猛药"
        },
        {
          "id": "03-bencao-ep12#80",
          "tStartMs": 2682000,
          "text": "如果肺里面有积水的时候"
        },
        {
          "id": "03-bencao-ep12#81",
          "tStartMs": 2714000,
          "text": "有葶苈子在这里排水就可以了。"
        },
        {
          "id": "03-bencao-ep12#82",
          "tStartMs": 2736000,
          "text": "这个时候不用半夏了，"
        }
      ]
    },
    {
      "segmentId": "03-bencao-ep12-s017",
      "chapter": "葶苈子",
      "contentType": "shennong-bencao",
      "completeness": "partial",
      "tStartMs": 2758000,
      "tEndMs": null,
      "internalGapsMs": [
        54000,
        32000,
        43000
      ],
      "cues": [
        {
          "id": "03-bencao-ep12#83",
          "tStartMs": 2758000,
          "text": "肝癌、肝硬化的腹水就是这样子"
        },
        {
          "id": "03-bencao-ep12#84",
          "tStartMs": 2812000,
          "text": "这些药是我们在治疗肺癌重症的时使用到的。桔梗"
        },
        {
          "id": "03-bencao-ep12#85",
          "tStartMs": 2844000,
          "text": "我痰焦黄的，那生半夏、天南星就解决了"
        },
        {
          "id": "03-bencao-ep12#86",
          "tStartMs": 2887000,
          "text": "它除了排脓以外还排血。"
        }
      ]
    },
    {
      "segmentId": "03-bencao-ep12-s018",
      "chapter": "葶苈子",
      "contentType": "shennong-bencao",
      "completeness": "partial",
      "tStartMs": 2963000,
      "tEndMs": null,
      "internalGapsMs": [
        22000,
        76000,
        24000,
        25000
      ],
      "cues": [
        {
          "id": "03-bencao-ep12#87",
          "tStartMs": 2963000,
          "text": "所以，老师他呼吸又很短，"
        },
        {
          "id": "03-bencao-ep12#88",
          "tStartMs": 2985000,
          "text": "诸位看！，本草经的原文"
        },
        {
          "id": "03-bencao-ep12#89",
          "tStartMs": 3061000,
          "text": "就是肉出血。这个病人很好玩啊"
        },
        {
          "id": "03-bencao-ep12#90",
          "tStartMs": 3085000,
          "text": "你看，主治浊唾，就是痰涎很浓稠"
        },
        {
          "id": "03-bencao-ep12#91",
          "tStartMs": 3110000,
          "text": "因为这是皆味、辛味，菁辛的。"
        }
      ]
    },
    {
      "segmentId": "03-bencao-ep12-s019",
      "chapter": "葶苈子",
      "contentType": "shennong-bencao",
      "completeness": "partial",
      "tStartMs": 3133000,
      "tEndMs": null,
      "internalGapsMs": [
        41000,
        61000
      ],
      "cues": [
        {
          "id": "03-bencao-ep12#92",
          "tStartMs": 3133000,
          "text": "我们要靠，恺如水很多，我们靠半夏啊对不对，"
        },
        {
          "id": "03-bencao-ep12#93",
          "tStartMs": 3174000,
          "text": "这个药现在我们也是用的不多"
        },
        {
          "id": "03-bencao-ep12#94",
          "tStartMs": 3235000,
          "text": "这个呢是我们治疗皮肤病、疥疮的主力药还有肝胆方面的，"
        }
      ]
    },
    {
      "segmentId": "03-bencao-ep12-s020",
      "chapter": "草蒿",
      "contentType": "shennong-bencao",
      "completeness": "partial",
      "tStartMs": 3249000,
      "tEndMs": null,
      "internalGapsMs": [
        37000,
        33000,
        27000,
        37000
      ],
      "cues": [
        {
          "id": "03-bencao-ep12#95",
          "tStartMs": 3249000,
          "text": "你用青蒿，比如青蒿两钱、三钱就草蒿，都可以"
        },
        {
          "id": "03-bencao-ep12#96",
          "tStartMs": 3286000,
          "text": "可能是胆結石啊或者肝炎，那就是实热"
        },
        {
          "id": "03-bencao-ep12#97",
          "tStartMs": 3319000,
          "text": "那这是单味药的使用。"
        },
        {
          "id": "03-bencao-ep12#98",
          "tStartMs": 3346000,
          "text": "所以补虚的药跟去热的药混在一起，就能够去他的虚热。"
        },
        {
          "id": "03-bencao-ep12#99",
          "tStartMs": 3403000,
          "text": "讲风就是讲肥脏，肝脏那一般的风热，都很好治"
        },
        {
          "id": "03-bencao-ep12#100",
          "tStartMs": 3440000,
          "text": "平常我们-一过去的古字就是“覆”，"
        }
      ]
    },
    {
      "segmentId": "03-bencao-ep12-s021",
      "chapter": "旋覆花",
      "contentType": "shennong-bencao",
      "completeness": "partial",
      "tStartMs": 3443000,
      "tEndMs": null,
      "internalGapsMs": [
        27000,
        36000,
        23000
      ],
      "cues": [
        {
          "id": "03-bencao-ep12#101",
          "tStartMs": 3443000,
          "text": "现在我们没有加这个“覆”，旋覆花"
        },
        {
          "id": "03-bencao-ep12#102",
          "tStartMs": 3470000,
          "text": "长成这样子，这旋覆花"
        },
        {
          "id": "03-bencao-ep12#103",
          "tStartMs": 3506000,
          "text": "所以我在国外用的很多，来的病人胃酸很多"
        },
        {
          "id": "03-bencao-ep12#104",
          "tStartMs": 3529000,
          "text": "所以你以后看到金沸草就是指旋覆花，金沸草"
        },
        {
          "id": "03-bencao-ep12#105",
          "tStartMs": 3614000,
          "text": "你都可以使用到旋覆花"
        }
      ]
    },
    {
      "segmentId": "03-bencao-ep12-s022",
      "chapter": "黎芦",
      "contentType": "shennong-bencao",
      "completeness": "partial",
      "tStartMs": 3666000,
      "tEndMs": null,
      "internalGapsMs": [
        5000,
        45000
      ],
      "cues": [
        {
          "id": "03-bencao-ep12#106",
          "tStartMs": 3666000,
          "text": "三百七十六，这个是是黎芦"
        },
        {
          "id": "03-bencao-ep12#107",
          "tStartMs": 3671000,
          "text": "过去这个黎芦呢是使用在催吐剂。这藜芦长得很像葱"
        },
        {
          "id": "03-bencao-ep12#108",
          "tStartMs": 3716000,
          "text": "藜芦长得样寻很像葱，一般我们现在药房没有"
        }
      ]
    },
    {
      "segmentId": "03-bencao-ep12-s023",
      "chapter": "钩吻",
      "contentType": "shennong-bencao",
      "completeness": "partial",
      "tStartMs": 3766000,
      "tEndMs": null,
      "internalGapsMs": [
        22000,
        43000,
        39000,
        20000,
        20000
      ],
      "cues": [
        {
          "id": "03-bencao-ep12#109",
          "tStartMs": 3766000,
          "text": "这是“钩吻”现代人呢一般都看不出来什么药了"
        },
        {
          "id": "03-bencao-ep12#110",
          "tStartMs": 3788000,
          "text": "这个是经方里面在使用的"
        },
        {
          "id": "03-bencao-ep12#111",
          "tStartMs": 3831000,
          "text": "这个药是很普遍的药，喉咙痛啊，喉咙堵塞啊"
        },
        {
          "id": "03-bencao-ep12#112",
          "tStartMs": 3870000,
          "text": "病人不管他里面是一一这个肺结核、"
        },
        {
          "id": "03-bencao-ep12#113",
          "tStartMs": 3890000,
          "text": "因为往是能够清火解毒，所以热症"
        },
        {
          "id": "03-bencao-ep12#114",
          "tStartMs": 3910000,
          "text": "所以一股来说实热物咳嗽，像百日咳啊，"
        },
        {
          "id": "03-bencao-ep12#115",
          "tStartMs": 3944000,
          "text": "蛇含草主治蛇咬啊，清热解毒的剂药。"
        }
      ]
    },
    {
      "segmentId": "03-bencao-ep12-s024",
      "chapter": "恒山 / 蜀漆 / 常山",
      "contentType": "shennong-bencao",
      "completeness": "partial",
      "tStartMs": 3947000,
      "tEndMs": null,
      "internalGapsMs": [
        3000,
        27000,
        43000,
        24000,
        33000,
        28000
      ],
      "cues": [
        {
          "id": "03-bencao-ep12#116",
          "tStartMs": 3947000,
          "text": "像三百人，叫恒山，我们也用得不多"
        },
        {
          "id": "03-bencao-ep12#117",
          "tStartMs": 3950000,
          "text": "像二百A十，叫恒山，我们也用得不多"
        },
        {
          "id": "03-bencao-ep12#118",
          "tStartMs": 3977000,
          "text": "281我们叫做“蜀漆\""
        },
        {
          "id": "03-bencao-ep12#119",
          "tStartMs": 4020000,
          "text": "常山，那病人往来寒热，忽冷忽热"
        },
        {
          "id": "03-bencao-ep12#120",
          "tStartMs": 4044000,
          "text": "那味道是辛苦，苦味的，辛辣的，主散，性寒"
        },
        {
          "id": "03-bencao-ep12#121",
          "tStartMs": 4077000,
          "text": "疟疾是因沩里面有痰，所以造成上吐下泻，"
        },
        {
          "id": "03-bencao-ep12#122",
          "tStartMs": 4097000,
          "text": "常山苗治疗症疾。在食物上面的时候"
        },
        {
          "id": "03-bencao-ep12#123",
          "tStartMs": 4125000,
          "text": "还在神农本草经里面，"
        }
      ]
    },
    {
      "segmentId": "03-bencao-ep12-s025",
      "chapter": "甘遂",
      "contentType": "shennong-bencao",
      "completeness": "partial",
      "tStartMs": 4146000,
      "tEndMs": null,
      "internalGapsMs": [
        3000,
        38000,
        20000,
        43000,
        27000
      ],
      "cues": [
        {
          "id": "03-bencao-ep12#124",
          "tStartMs": 4146000,
          "text": "二百人十二，甘遂，"
        },
        {
          "id": "03-bencao-ep12#125",
          "tStartMs": 4149000,
          "text": "你如果哪天神经不是很正常，你把甘遂拿来吃吃看"
        },
        {
          "id": "03-bencao-ep12#126",
          "tStartMs": 4187000,
          "text": "开一剂经验好的，甘遂，开三钱，看多了"
        },
        {
          "id": "03-bencao-ep12#127",
          "tStartMs": 4207000,
          "text": "这个甘遂你可以磨粉做成粉剂，也可以生药直接用"
        },
        {
          "id": "03-bencao-ep12#128",
          "tStartMs": 4250000,
          "text": "这是单味药的使用。"
        },
        {
          "id": "03-bencao-ep12#129",
          "tStartMs": 4277000,
          "text": "这个有个规矩，这两味药使用的时候一定要看到脚肺"
        }
      ]
    },
    {
      "segmentId": "03-bencao-ep12-s026",
      "chapter": "甘遂",
      "contentType": "shennong-bencao",
      "completeness": "partial",
      "tStartMs": 4299000,
      "tEndMs": null,
      "internalGapsMs": [
        38000,
        25000,
        24000,
        35000,
        21000
      ],
      "cues": [
        {
          "id": "03-bencao-ep12#130",
          "tStartMs": 4299000,
          "text": "你压下去又弹起来这不是实水，不可以使用"
        },
        {
          "id": "03-bencao-ep12#131",
          "tStartMs": 4337000,
          "text": "可以把水吐、泻整个排掉"
        },
        {
          "id": "03-bencao-ep12#132",
          "tStartMs": 4362000,
          "text": "所以这一段时间禁忌一定要记得，"
        },
        {
          "id": "03-bencao-ep12#133",
          "tStartMs": 4386000,
          "text": "所以请大家务必要记住。这是腹水"
        },
        {
          "id": "03-bencao-ep12#134",
          "tStartMs": 4421000,
          "text": "甘遂处方的时候我们用钱做单位，三钱一剂。"
        },
        {
          "id": "03-bencao-ep12#135",
          "tStartMs": 4442000,
          "text": "一包一次是一钱，一钱里面有三分之一是甘遂粉，"
        }
      ]
    },
    {
      "segmentId": "03-bencao-ep12-s027",
      "chapter": "甘遂",
      "contentType": "shennong-bencao",
      "completeness": "partial",
      "tStartMs": 4533000,
      "tEndMs": null,
      "internalGapsMs": [
        25000,
        25000,
        26000,
        68000
      ],
      "cues": [
        {
          "id": "03-bencao-ep12#136",
          "tStartMs": 4533000,
          "text": "居然，甘遂、芫花、大戟都是］"
        },
        {
          "id": "03-bencao-ep12#137",
          "tStartMs": 4558000,
          "text": "一剂就够了。所以你要对症。"
        },
        {
          "id": "03-bencao-ep12#138",
          "tStartMs": 4583000,
          "text": "生半夏还不敢用，那你怎么可以治这种症，当然不能治啊"
        },
        {
          "id": "03-bencao-ep12#139",
          "tStartMs": 4609000,
          "text": "十枣汤，甘遂是非常好使用的排水的药物"
        },
        {
          "id": "03-bencao-ep12#140",
          "tStartMs": 4677000,
          "text": "因为要喷的时候要喷出去，那甘遂喷到这边墙壁上"
        }
      ]
    },
    {
      "segmentId": "03-bencao-ep12-s028",
      "chapter": "甘遂",
      "contentType": "shennong-bencao",
      "completeness": "partial",
      "tStartMs": 4720000,
      "tEndMs": null,
      "internalGapsMs": [
        39000,
        20000,
        22000,
        23000,
        23000
      ],
      "cues": [
        {
          "id": "03-bencao-ep12#141",
          "tStartMs": 4720000,
          "text": "所以中药的排水药"
        },
        {
          "id": "03-bencao-ep12#142",
          "tStartMs": 4759000,
          "text": "这个【禁忌】恶远志反甘草，本来这个甘遂；"
        },
        {
          "id": "03-bencao-ep12#143",
          "tStartMs": 4779000,
          "text": "所以我们叫丰枣汤，我们不会叫车甘汤"
        },
        {
          "id": "03-bencao-ep12#144",
          "tStartMs": 4801000,
          "text": "以我们同样的甘遂可以去上焦，喉呢，肺里面的"
        },
        {
          "id": "03-bencao-ep12#145",
          "tStartMs": 4824000,
          "text": "所以我说如果你觉得人生乏味，"
        },
        {
          "id": "03-bencao-ep12#146",
          "tStartMs": 4847000,
          "text": "力量就没了，就不叫甘遂了，生用力量最强。"
        }
      ]
    },
    {
      "segmentId": "03-bencao-ep12-s029",
      "chapter": "白敛",
      "contentType": "shennong-bencao",
      "completeness": "partial",
      "tStartMs": 4860000,
      "tEndMs": null,
      "internalGapsMs": [
        28000,
        58000,
        54000
      ],
      "cues": [
        {
          "id": "03-bencao-ep12#147",
          "tStartMs": 4860000,
          "text": "这个自敛味苦，平，无毒"
        },
        {
          "id": "03-bencao-ep12#148",
          "tStartMs": 4888000,
          "text": "刺鼻、就是那个酒糟鼻、红鼻子嘛"
        },
        {
          "id": "03-bencao-ep12#149",
          "tStartMs": 4946000,
          "text": "这个是草决明。跟决明子很类似"
        },
        {
          "id": "03-bencao-ep12#150",
          "tStartMs": 5000000,
          "text": "你只要有经方做基础，"
        },
        {
          "id": "03-bencao-ep12#151",
          "tStartMs": 5032000,
          "text": "眼翳的间题我们通通使用，在肝经上面来判断"
        }
      ]
    }
  ]
}